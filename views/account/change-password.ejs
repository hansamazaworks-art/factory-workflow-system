<%- include('../partials/header', { title: 'Change Password', user, active }) %>

<div class="content-header">
  <div>
    <h1>Change Password</h1>
    <div class="subtle">Logged in as <%= user.username %></div>
  </div>
</div>

<div class="card" style="max-width:460px">
  <% if (forced) { %>
    <div class="notice-box warn mb16" role="alert">
      You're still using the starter password everyone was given. Choose your own password to continue.
    </div>
  <% } %>
  <% if (error) { %>
    <div class="error-box" role="alert"><%= error %></div>
  <% } %>
  <% if (success) { %>
    <div class="success-box" role="status">
      Password updated. <a href="<%= homeUrl %>">Continue to your dashboard &rarr;</a>
    </div>
  <% } %>

  <form method="POST" action="/account/change-password">
    <label for="current_password">Current Password</label>
    <input type="password" id="current_password" name="current_password" autocomplete="current-password" required>

    <label for="new_password">New Password</label>
    <input type="password" id="new_password" name="new_password" autocomplete="new-password" minlength="8" required
           aria-describedby="pw-hint">
    <div id="pw-hint" class="stat-note">At least 8 characters.</div>

    <label for="confirm_password">Confirm New Password</label>
    <input type="password" id="confirm_password" name="confirm_password" autocomplete="new-password" minlength="8" required>

    <div class="form-actions"><button type="submit" class="btn">Update Password</button></div>
  </form>
</div>

<%- include('../partials/footer') %>
