# Copy this file to .env and fill in your own values.
# This file runs on the ONE computer that will act as the "host" PC.

PORT=3000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=factory_system

# Any long random string - used to sign login sessions.
SESSION_SECRET=change_this_to_something_random

# Purchase orders with a total BELOW this amount are auto-approved
# and skip Management's queue entirely. Set to 0 to require Management
# approval on every purchase order regardless of amount.
AUTO_APPROVE_LIMIT=5000

# Only set this to true if the app is served over https. On the plain
# http LAN setup it must stay false, or nobody can log in.
COOKIE_SECURE=false

# The plant's time zone (an IANA name). Every date the app shows,
# compares or stores uses it, whatever the PC clock is set to.
# Asia/Manila and Asia/Singapore are both UTC+08:00 all year.
COMPANY_TIMEZONE=Asia/Manila
